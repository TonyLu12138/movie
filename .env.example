# No MySQL installation is needed for the default SQLite database.
# DATABASE_URL=sqlite:///movies.sqlite3
# To use an EXISTING MySQL 8+ server, create an empty utf8mb4 database first:
# DATABASE_URL=mysql+pymysql://movie_user:URL_ENCODED_PASSWORD@127.0.0.1:3306/movies?charset=utf8mb4
PORT=8000
# Set false when restoring a complete backup into an empty database.
AUTO_IMPORT=true
